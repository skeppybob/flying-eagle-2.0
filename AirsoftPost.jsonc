{
  "name": "AirsoftPost",
  "type": "object",
  "properties": {
    "creator_name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "battle_location": {
      "type": "string"
    },
    "media_url": {
      "type": "string"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "image",
        "video"
      ]
    },
    "moderated": {
      "type": "boolean",
      "default": false
    },
    "flagged": {
      "type": "boolean",
      "default": false
    },
    "moderation_note": {
      "type": "string"
    }
  },
  "required": [
    "creator_name",
    "title",
    "media_url",
    "media_type"
  ]
}
